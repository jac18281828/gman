##
## vase.rib -- a room with a table, a vase of flowers and water, and a
## small robot on six wheels that just drove into the table. World is Z-up
## (floor at z=0); x is left/right, y is depth (back wall at y=-4, camera
## outside the open front), z is up. Table height, vase height and flower
## height each follow the golden ratio. A lamp hangs over the table and a
## cool distant light fills from above. The vase and the water carry a
## partial Opacity, so the ray-traced render shows the table through them.
##

Display "vase.png" "file" "rgba"
Format 640 400 1
PixelSamples 2 2
Projection "perspective" "fov" [40]
Clipping 0.5 60

# camera: rotate into the room's orientation, then pull back to frame it
Translate 0 -1.6 7.8
Rotate -100 1 0 0

WorldBegin

LightSource "ambientlight" 1 "intensity" [0.38]
LightSource "pointlight" 2 "intensity" [9] "lightcolor" [1 0.95 0.83]
	"from" [0.2 0.3 3.2]
LightSource "distantlight" 3 "intensity" [0.85] "lightcolor" [0.65 0.8 1]
	"from" [-1 2 10] "to" [0 0 1]

Sides 2

## Room: floor + back/left/right walls, open front and ceiling
Surface "matte" "Ka" [0.35] "Kd" [0.65]

Color [0.8 0.74 0.63]
Polygon "P" [-3 -4 0  3 -4 0  3 8 0  -3 8 0]

Color [0.56 0.7 0.58]
Polygon "P" [-3 -4 0  3 -4 0  3 -4 7.5  -3 -4 7.5]
Color [0.54 0.64 0.8]
Polygon "P" [-3 -4 0  -3 8 0  -3 8 7.5  -3 -4 7.5]
Polygon "P" [3 8 0  3 -4 0  3 -4 7.5  3 8 7.5]

## Table: square top on 4 square legs, knocked up off the floor mid-bump
AttributeBegin
	Surface "plastic" "Ka" [0.25] "Kd" [0.6] "Ks" [0.25] "roughness" [0.2]
		"specularcolor" [1 1 1]
	Color [0.42 0.26 0.14]
	Translate 0.22 0.05 0.43
	Rotate 11 0 1 0
	Rotate -6 1 0 0

	# tabletop
	Polygon "P" [-1.1 -1.1 0.72  1.1 -1.1 0.72  1.1 -1.1 0.8  -1.1 -1.1 0.8]
	Polygon "P" [-1.1 1.1 0.72  1.1 1.1 0.72  1.1 1.1 0.8  -1.1 1.1 0.8]
	Polygon "P" [-1.1 -1.1 0.8  1.1 -1.1 0.8  1.1 1.1 0.8  -1.1 1.1 0.8]
	Polygon "P" [1.1 -1.1 0.72  -1.1 -1.1 0.72  -1.1 1.1 0.72  1.1 1.1 0.72]
	Polygon "P" [-1.1 -1.1 0.8  -1.1 -1.1 0.72  -1.1 1.1 0.72  -1.1 1.1 0.8]
	Polygon "P" [1.1 -1.1 0.72  1.1 -1.1 0.8  1.1 1.1 0.8  1.1 1.1 0.72]

	# leg +x+y
	Polygon "P" [0.73 0.73 0  0.95 0.73 0  0.95 0.73 0.72  0.73 0.73 0.72]
	Polygon "P" [0.73 0.95 0  0.95 0.95 0  0.95 0.95 0.72  0.73 0.95 0.72]
	Polygon "P" [0.73 0.73 0.72  0.95 0.73 0.72  0.95 0.95 0.72  0.73 0.95 0.72]
	Polygon "P" [0.95 0.73 0  0.73 0.73 0  0.73 0.95 0  0.95 0.95 0]
	Polygon "P" [0.73 0.73 0.72  0.73 0.73 0  0.73 0.95 0  0.73 0.95 0.72]
	Polygon "P" [0.95 0.73 0  0.95 0.73 0.72  0.95 0.95 0.72  0.95 0.95 0]

	# leg +x-y
	Polygon "P" [0.73 -0.95 0  0.95 -0.95 0  0.95 -0.95 0.72  0.73 -0.95 0.72]
	Polygon "P" [0.73 -0.73 0  0.95 -0.73 0  0.95 -0.73 0.72  0.73 -0.73 0.72]
	Polygon "P" [0.73 -0.95 0.72  0.95 -0.95 0.72  0.95 -0.73 0.72  0.73 -0.73 0.72]
	Polygon "P" [0.95 -0.95 0  0.73 -0.95 0  0.73 -0.73 0  0.95 -0.73 0]
	Polygon "P" [0.73 -0.95 0.72  0.73 -0.95 0  0.73 -0.73 0  0.73 -0.73 0.72]
	Polygon "P" [0.95 -0.95 0  0.95 -0.95 0.72  0.95 -0.73 0.72  0.95 -0.73 0]

	# leg -x+y
	Polygon "P" [-0.95 0.73 0  -0.73 0.73 0  -0.73 0.73 0.72  -0.95 0.73 0.72]
	Polygon "P" [-0.95 0.95 0  -0.73 0.95 0  -0.73 0.95 0.72  -0.95 0.95 0.72]
	Polygon "P" [-0.95 0.73 0.72  -0.73 0.73 0.72  -0.73 0.95 0.72  -0.95 0.95 0.72]
	Polygon "P" [-0.73 0.73 0  -0.95 0.73 0  -0.95 0.95 0  -0.73 0.95 0]
	Polygon "P" [-0.95 0.73 0.72  -0.95 0.73 0  -0.95 0.95 0  -0.95 0.95 0.72]
	Polygon "P" [-0.73 0.73 0  -0.73 0.73 0.72  -0.73 0.95 0.72  -0.73 0.95 0]

	# leg -x-y
	Polygon "P" [-0.95 -0.95 0  -0.73 -0.95 0  -0.73 -0.95 0.72  -0.95 -0.95 0.72]
	Polygon "P" [-0.95 -0.73 0  -0.73 -0.73 0  -0.73 -0.73 0.72  -0.95 -0.73 0.72]
	Polygon "P" [-0.95 -0.95 0.72  -0.73 -0.95 0.72  -0.73 -0.73 0.72  -0.95 -0.73 0.72]
	Polygon "P" [-0.73 -0.95 0  -0.95 -0.95 0  -0.95 -0.73 0  -0.73 -0.73 0]
	Polygon "P" [-0.95 -0.95 0.72  -0.95 -0.95 0  -0.95 -0.73 0  -0.95 -0.73 0.72]
	Polygon "P" [-0.73 -0.95 0  -0.73 -0.95 0.72  -0.73 -0.73 0.72  -0.73 -0.73 0]
AttributeEnd

## Vase: tipped well past the table's own tilt, base lifted clear of the top
AttributeBegin
	Surface "plastic" "Ka" [0.25] "Kd" [0.55] "Ks" [0.4] "roughness" [0.1]
		"specularcolor" [1 1 1]
	Color [0.15 0.5 0.55]
	Opacity [0.55 0.55 0.55]
	Translate 0.55 0.12 1.36
	Rotate 40 0 1 0
	Scale 1.15 1.15 1.15

	Disk 0 0.22 360
	Hyperboloid 0.22 0 0  0.30 0 0.20  360
	Hyperboloid 0.30 0 0.20  0.13 0 0.42  360
	Hyperboloid 0.13 0 0.42  0.19 0 0.50  360

	# water, level while the vase leans
	AttributeBegin
		Surface "plastic" "Ka" [0.2] "Kd" [0.45] "Ks" [0.6] "roughness" [0.06]
			"specularcolor" [1 1 1]
		Color [0.2 0.5 0.9]
		Opacity [0.7 0.7 0.7]
		Translate 0 0 0.26
		Rotate -40 0 1 0
		Disk 0 0.215 360
	AttributeEnd
AttributeEnd

## Water that got out: drops flung clear of the lip, a blob on the tabletop
AttributeBegin
	Surface "plastic" "Ka" [0.2] "Kd" [0.45] "Ks" [0.6] "roughness" [0.06]
		"specularcolor" [1 1 1]
	Color [0.2 0.5 0.9]
	Opacity [0.7 0.7 0.7]
	# flung clear of the lip, stretched along its flight and twisting
	AttributeBegin
		Translate 1.42 0.02 1.74
		Rotate 62 0 1 0
		Rotate 14 1 0 0
		Scale 0.75 1.05 2.6
		Sphere 0.06 -0.06 0.06 360
	AttributeEnd
	AttributeBegin
		Translate 1.27 0.05 1.66
		Rotate 48 0 1 0
		Rotate -20 1 0 0
		Scale 0.7 0.9 2.2
		Sphere 0.035 -0.035 0.035 360
	AttributeEnd
	AttributeBegin
		Translate 1.64 -0.02 1.83
		Rotate 70 0 1 0
		Scale 0.8 0.8 1.8
		Sphere 0.025 -0.025 0.025 360
	AttributeEnd
	AttributeBegin
		Translate 0.22 0.05 0.43
		Rotate 11 0 1 0
		Rotate -6 1 0 0
		Translate 0.72 0.3 0.81
		Scale 1.5 1 0.3
		Sphere 0.12 -0.12 0.12 360
	AttributeEnd
AttributeEnd

## Flowers: ejected to the right along the vase's own axis, fanning apart
AttributeBegin
	Surface "matte" "Ka" [0.3] "Kd" [0.65]
	Translate 1.0 0.0 1.9
	Rotate 28 0 1 0.4
	Color [0.22 0.5 0.2]
	Cylinder 0.015 0 0.4 360
	Translate 0 0 0.4
	Color [0.85 0.15 0.15]
	Sphere 0.09 -0.09 0.09 360
AttributeEnd

AttributeBegin
	Surface "matte" "Ka" [0.3] "Kd" [0.65]
	Translate 1.05 0.35 2.0
	Rotate 48 0 1 -0.35
	Color [0.22 0.5 0.2]
	Cylinder 0.015 0 0.32 360
	Translate 0 0 0.32
	Color [0.95 0.8 0.1]
	Sphere 0.09 -0.09 0.09 360
AttributeEnd

AttributeBegin
	Surface "matte" "Ka" [0.3] "Kd" [0.65]
	Translate 1.15 -0.15 2.1
	Rotate 62 0 1 0.2
	Color [0.22 0.5 0.2]
	Cylinder 0.015 0 0.36 360
	Translate 0 0 0.36
	Color [0.85 0.35 0.55]
	Sphere 0.09 -0.09 0.09 360
AttributeEnd

## Robot: bubble-domed helper on six wheels, leaning back from the impact
## with its left hand braced on the tabletop's edge. Built upright facing
## local +y, then yawed to its driving direction and pitched back.
AttributeBegin
	Surface "plastic" "Ka" [0.25] "Kd" [0.6] "Ks" [0.3] "roughness" [0.15]
		"specularcolor" [1 1 1]
	Translate -1.12 0.15 0.29
	Rotate -90 0 0 1
	Rotate 8 1 0 0

	# six wheels
	AttributeBegin
		Color [0.3 0.3 0.33]
		AttributeBegin
			Translate -0.34 -0.21 -0.13
			Rotate 90 0 1 0
			Cylinder 0.13 -0.05 0.05 360
			Disk -0.05 0.13 360
			Disk 0.05 0.13 360
			AttributeBegin
				Color [0.95 0.8 0.15]
				Disk -0.051 0.05 360
				Disk 0.051 0.05 360
			AttributeEnd
		AttributeEnd
		AttributeBegin
			Translate -0.34 0 -0.13
			Rotate 90 0 1 0
			Cylinder 0.13 -0.05 0.05 360
			Disk -0.05 0.13 360
			Disk 0.05 0.13 360
			AttributeBegin
				Color [0.95 0.8 0.15]
				Disk -0.051 0.05 360
				Disk 0.051 0.05 360
			AttributeEnd
		AttributeEnd
		AttributeBegin
			Translate -0.34 0.21 -0.13
			Rotate 90 0 1 0
			Cylinder 0.13 -0.05 0.05 360
			Disk -0.05 0.13 360
			Disk 0.05 0.13 360
			AttributeBegin
				Color [0.95 0.8 0.15]
				Disk -0.051 0.05 360
				Disk 0.051 0.05 360
			AttributeEnd
		AttributeEnd
		AttributeBegin
			Translate 0.34 -0.21 -0.13
			Rotate 90 0 1 0
			Cylinder 0.13 -0.05 0.05 360
			Disk -0.05 0.13 360
			Disk 0.05 0.13 360
			AttributeBegin
				Color [0.95 0.8 0.15]
				Disk -0.051 0.05 360
				Disk 0.051 0.05 360
			AttributeEnd
		AttributeEnd
		AttributeBegin
			Translate 0.34 0 -0.13
			Rotate 90 0 1 0
			Cylinder 0.13 -0.05 0.05 360
			Disk -0.05 0.13 360
			Disk 0.05 0.13 360
			AttributeBegin
				Color [0.95 0.8 0.15]
				Disk -0.051 0.05 360
				Disk 0.051 0.05 360
			AttributeEnd
		AttributeEnd
		AttributeBegin
			Translate 0.34 0.21 -0.13
			Rotate 90 0 1 0
			Cylinder 0.13 -0.05 0.05 360
			Disk -0.05 0.13 360
			Disk 0.05 0.13 360
			AttributeBegin
				Color [0.95 0.8 0.15]
				Disk -0.051 0.05 360
				Disk 0.051 0.05 360
			AttributeEnd
		AttributeEnd
	AttributeEnd

	# hover skirt
	Color [0.82 0.28 0.15]
	Disk 0 0.35 360
	Hyperboloid 0.35 0 0  0.22 0 0.26  360

	# torso
	AttributeBegin
		Color [0.93 0.88 0.76]
		Translate 0 0 0.52
		Scale 1 1 1.2
		Sphere 0.27 -0.27 0.27 360
	AttributeEnd

	# belt
	AttributeBegin
		Color [0.82 0.28 0.15]
		Translate 0 0 0.52
		Torus 0.28 0.04 -180 180 360
	AttributeEnd

	# neck
	AttributeBegin
		Color [0.85 0.85 0.82]
		Translate 0 0 0.844
		Cylinder 0.09 0 0.1 360
	AttributeEnd

	# head dome
	AttributeBegin
		Surface "plastic" "Ka" [0.2] "Kd" [0.5] "Ks" [0.5] "roughness" [0.08]
			"specularcolor" [1 1 1]
		Color [0.55 0.8 0.92]
		Translate 0 0 0.944
		Sphere 0.24 -0.08 0.24 360
	AttributeEnd

	# collar
	AttributeBegin
		Color [0.3 0.3 0.32]
		Translate 0 0 0.88
		Torus 0.22 0.03 -180 180 360
	AttributeEnd

	# eyes
	AttributeBegin
		Color [0.05 0.08 0.15]
		Translate 0.09 0.2 0.97
		Sphere 0.035 -0.035 0.035 360
	AttributeEnd
	AttributeBegin
		Color [0.05 0.08 0.15]
		Translate -0.09 0.2 0.97
		Sphere 0.035 -0.035 0.035 360
	AttributeEnd

	# antenna, bent for whimsy
	AttributeBegin
		Color [0.85 0.85 0.82]
		Translate 0.05 0 1.184
		Rotate 20 1 0.3 0
		Cylinder 0.02 0 0.16 360
		Translate 0 0 0.16
		Color [0.95 0.8 0.15]
		Sphere 0.05 -0.05 0.05 360
	AttributeEnd

	# right arm: shoulder ball, flung up and back in surprise
	AttributeBegin
		Color [0.93 0.88 0.76]
		Translate 0.32 0 0.62
		Sphere 0.075 -0.075 0.075 360
	AttributeEnd
	AttributeBegin
		Color [0.93 0.88 0.76]
		Translate 0.32 0 0.62
		Rotate 55 1 0 0
		Cylinder 0.045 0 0.42 360
		Translate 0 0 0.42
		Color [0.75 0.75 0.78]
		Sphere 0.065 -0.065 0.065 360
	AttributeEnd

	# left arm: shoulder ball, braced up against the tabletop's edge
	AttributeBegin
		Color [0.93 0.88 0.76]
		Translate -0.32 0 0.6
		Sphere 0.075 -0.075 0.075 360
	AttributeEnd
	AttributeBegin
		Color [0.93 0.88 0.76]
		Translate -0.32 0 0.6
		Rotate -53 1 0 0
		Cylinder 0.045 0 0.38 360
		Translate 0 0 0.38
		Color [0.75 0.75 0.78]
		Sphere 0.065 -0.065 0.065 360
	AttributeEnd
AttributeEnd

WorldEnd
