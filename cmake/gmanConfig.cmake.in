# SPDX-License-Identifier: LGPL-2.1-or-later
#
# The gman CMake package. A consumer writes find_package(gman CONFIG
# REQUIRED) and links gman::gman_core, gman::gman_ray when it uses the ray
# geometry, the BVH, the emitters or the indirect-light pass, and
# gman::gman_raster when it uses the body, face and vertex model, the patch
# and polygon object manager or the polygon clipper.

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# gman_core's PUBLIC link dependencies; PRIVATE ones (libtiff, libpng,
# libjpeg) stay internal to the shared library and need no find_dependency.
find_dependency(ZLIB)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/gmanTargets.cmake")

check_required_components(gman)
