// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-dockerfile
{
	"name": "GMAN",
	"build": {
		// Sets the run context to one level up instead of the .devcontainer folder.
		"context": "..",
		// Update the 'dockerFile' property if you aren't using the standard 'Dockerfile' filename.
		"dockerfile": "../Dockerfile"
	},
	"workspaceFolder": "/workspaces/gman",
	"remoteUser": "gman",
	// No per-container "settings" override here: .vscode/settings.json is
	// workspace-wide and VS Code applies it over a remote's own settings, so
	// a divergent value here would be silently discarded in favor of the
	// checked-in workspace one -- .vscode/settings.json and
	// .vscode/launch.json already point at this container's build directory
	// directly.
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cpptools",
				"ms-vscode.cmake-tools",
				"llvm-vs-code-extensions.vscode-clangd"
			]
		}
	},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Configures IntelliSense on container creation. Builds to a
	// container-local directory, not ${workspaceFolder}/build -- that path is
	// the *host's* build/ once bind-mounted, and this container's toolchain
	// must not write object files there (see build.sh).
	"postCreateCommand": "cmake -S . -B /tmp/build-dev -DCMAKE_BUILD_TYPE=RelWithDebInfo -DCMAKE_CXX_FLAGS=\"-Wall -Wextra -Werror\" -DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
}
