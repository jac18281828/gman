---
# SPDX-License-Identifier: LGPL-2.1-or-later
#
# The tree carries no consistent style. This config is for new and touched
# code going forward, not a mandate to reformat the history behind it
# (AGENTS.md: no cosmetic churn riding along with a behavior change).
# `format-check` (CMakeLists.txt)
# runs it over the explicit file list this phase wrote to a single,
# consistent style, not all of tests/**; widen that list only as more
# of the tree is deliberately touched and reformatted on its own commit.
Language: Cpp
BasedOnStyle: Google
IndentWidth: 2
ColumnLimit: 80
AccessModifierOffset: -2
AllowShortFunctionsOnASingleLine: Empty
DerivePointerAlignment: false
PointerAlignment: Right
SortIncludes: false
IncludeBlocks: Regroup
IncludeCategories:
  # 1. C++ standard library: angle brackets, no extension.
  - Regex: '^<[a-z_]+>$'
    Priority: 1
  # 3. Libraries, matched ahead of the general system category below.
  - Regex: '^<(tiffio|png|jpeglib|zlib)\.h>$'
    Priority: 3
  # 2. System: every other angle-bracket header.
  - Regex: '^<.*>$'
    Priority: 2
  # 4. gman: every quoted include.
  - Regex: '^".*"$'
    Priority: 4
# No include is ever the main include: a project header never outranks the
# standard library, and a source file's own header sorts with its group.
IncludeIsMainRegex: '$^'
