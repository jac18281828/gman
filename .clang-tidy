# SPDX-License-Identifier: LGPL-2.1-or-later
#
# Security plus high-signal defect checks, each firing on a real bug, not a
# style preference, two hygiene checks and gman's house rules.
# misc-include-cleaner: a missing direct include is a latent build break,
# since a header that drops a transitive include stops an unrelated file
# compiling. modernize-use-std-numbers: one wrong hand-typed constant is a
# wrong calculation. No other modernize-*, readability-* or
# cppcoreguidelines-*: their volume on this tree would bury the findings that
# are bugs. tidy-check runs this file over every production source and
# header; tests/ goes unchecked.
#
# The house rules are the custom-gman-* checks under CustomChecks, each a
# clang-query matcher. clang-tidy 22.1.8 registers a custom check only under
# --experimental-custom-checks, which tidy-check passes; without the flag it
# drops them without a word. The checks read the AST of the active build, so
# code in an inactive preprocessor branch escapes them, and so does libtiff
# macro-only use (TIFFTAG_*, COMPRESSION_*), which names no declaration.
Checks: >
  -*,
  bugprone-unsafe-functions,
  bugprone-use-after-move,
  bugprone-dangling-handle,
  bugprone-not-null-terminated-result,
  cert-err34-c,
  clang-analyzer-security.*,
  clang-analyzer-core.*,
  clang-analyzer-cplusplus.*,
  clang-analyzer-unix.*,
  misc-include-cleaner,
  modernize-use-std-numbers,
  custom-*
CustomChecks:
  # typeLoc names types, declRefExpr functions, varDecl a deduced type.
  - Name: gman-thread-seam
    Query: |
      let threading namedDecl(matchesName("^::std::(thread|jthread|this_thread|stop_token|stop_source|stop_callback|async|future|shared_future|promise|packaged_task|once_flag|call_once|latch|barrier|counting_semaphore|binary_semaphore)(::|$)"))
      let locking namedDecl(matchesName("^::std::(mutex|timed_mutex|recursive_mutex|recursive_timed_mutex|shared_mutex|shared_timed_mutex|lock_guard|scoped_lock|unique_lock|shared_lock|lock|try_lock|condition_variable|condition_variable_any)(::|$)"))
      let atomics namedDecl(matchesName("^::std::atomic(_[a-z0-9_]+)?(::|$)"))
      let posix namedDecl(matchesName("^::pthread_"))
      let threadName anyOf(threading, locking, atomics, posix)
      let outsideSeam unless(anyOf(isExpansionInSystemHeader(), isExpansionInFileMatching("/libgman/gmanparallel[.]cpp$")))
      let gmanlogLock allOf(isExpansionInFileMatching("/libgman/gmanlog[.]cpp$"), loc(qualType(hasDeclaration(namedDecl(matchesName("^::std::(mutex|lock_guard)$"))))))
      match typeLoc(outsideSeam, loc(qualType(hasDeclaration(threadName))), unless(gmanlogLock)).bind("site")
      match declRefExpr(outsideSeam, to(threadName)).bind("site")
      let gmanlogCtad allOf(isExpansionInFileMatching("/libgman/gmanlog[.]cpp$"), hasType(hasCanonicalType(hasDeclaration(namedDecl(matchesName("^::std::(mutex|lock_guard)$"))))))
      match varDecl(outsideSeam, hasType(deducedTemplateSpecializationType()), hasType(hasCanonicalType(hasDeclaration(threadName))), unless(gmanlogCtad)).bind("site")
      match cxxConstructExpr(outsideSeam, hasType(deducedTemplateSpecializationType()), hasType(hasCanonicalType(hasDeclaration(threadName))), unless(gmanlogCtad)).bind("site")
    Diagnostic:
      - BindName: site
        Message: "name no thread primitive outside libgman/gmanparallel.cpp; run the work through gman::parallelFor"
        Level: Warning
  - Name: gman-tiff-seam
    Query: |
      let tiffDecl namedDecl(isExpansionInFileMatching("/tiff(io|conf|vers)?[.]h$"))
      let outsideSeam unless(anyOf(isExpansionInSystemHeader(), isExpansionInFileMatching("/libgman/gmantiff[.]cpp$")))
      match typeLoc(outsideSeam, loc(qualType(hasDeclaration(tiffDecl)))).bind("site")
      match declRefExpr(outsideSeam, to(tiffDecl)).bind("site")
    Diagnostic:
      - BindName: site
        Message: "name no libtiff declaration outside libgman/gmantiff.cpp; go through libgman/gmantiff.h"
        Level: Warning
  # asString misses the sugared const value_type of s[0]; use the canonical type.
  - Name: gman-cctype-argument
    Query: |
      match callExpr(callee(functionDecl(hasAnyName("::tolower", "::toupper", "::isalnum", "::isalpha", "::isblank", "::iscntrl", "::isdigit", "::isgraph", "::islower", "::isprint", "::ispunct", "::isspace", "::isupper", "::isxdigit"))), hasArgument(0, ignoringImpCasts(expr(hasType(hasCanonicalType(anyOf(asString("char"), asString("const char"), asString("signed char"), asString("const signed char")))))))).bind("site")
    Diagnostic:
      - BindName: site
        Message: "pass a <cctype> function static_cast<unsigned char>(c); a char above 127 is undefined behavior"
        Level: Warning
  # static_cast<char>(...) holds an implicit cast, so only one outside it counts.
  - Name: gman-tolower-narrowing
    Query: |
      match implicitCastExpr(hasType(isAnyCharacter()), unless(hasParent(explicitCastExpr())), hasSourceExpression(ignoringParens(callExpr(callee(functionDecl(hasAnyName("::tolower", "::toupper"))))))).bind("site")
    Diagnostic:
      - BindName: site
        Message: "tolower and toupper return an int; narrow it with static_cast<char>(...)"
        Level: Warning
  - Name: gman-new-char-array
    Query: |
      match cxxNewExpr(isArray(), hasType(pointerType(pointee(hasCanonicalType(anyOf(asString("char"), asString("const char"))))))).bind("site")
    Diagnostic:
      - BindName: site
        Message: "build strings with std::string and std::format, not new char[]"
        Level: Warning
  # PATH_MAX's literal reports in a system header, so bind an enclosing node.
  - Name: gman-path-max
    Query: |
      match integerLiteral(isExpandedFromMacro("PATH_MAX"), hasAncestor(stmt(unless(anyOf(implicitCastExpr(), constantExpr()))).bind("site")))
      match integerLiteral(isExpandedFromMacro("PATH_MAX"), unless(hasAncestor(stmt(unless(anyOf(implicitCastExpr(), constantExpr()))))), hasAncestor(namedDecl().bind("site")))
    Diagnostic:
      - BindName: site
        Message: "PATH_MAX is no bound for a path; use std::filesystem::path or std::string"
        Level: Warning
  - Name: gman-global-prefix
    Query: |
      match cxxRecordDecl(isDefinition(), unless(isImplicit()), unless(isTemplateInstantiation()), anyOf(isClass(), isStruct()), hasDeclContext(anyOf(translationUnitDecl(), linkageSpecDecl(hasDeclContext(translationUnitDecl())))), unless(matchesName("^::GMAN"))).bind("site")
    Diagnostic:
      - BindName: site
        Message: "a class at global scope carries the GMAN prefix; put it in a namespace to drop it"
        Level: Warning
  - Name: gman-namespace-prefix
    Query: |
      match cxxRecordDecl(isDefinition(), unless(isImplicit()), anyOf(isClass(), isStruct()), hasDeclContext(namespaceDecl(anyOf(hasAnyName("::gman", "::gmanshader"), hasAncestor(namespaceDecl(hasAnyName("::gman", "::gmanshader")))))), matchesName("::GMAN[^:]*$")).bind("site")
    Diagnostic:
      - BindName: site
        Message: "a class in namespace gman or gmanshader sheds the GMAN prefix"
        Level: Warning
  - Name: gman-shader-state
    Query: |
      match varDecl(unless(isExpansionInSystemHeader()), isExpansionInFileMatching("/shaders/[^/]+$"), anyOf(isStaticLocal(), hasDeclContext(recordDecl()))).bind("site")
    Diagnostic:
      - BindName: site
        Message: "a shader holds no state: no function-local static and no static data member"
        Level: Warning
# Every finding fails the job; that red is what the operator watches.
WarningsAsErrors: '*'
# Directory-name match only -- a static file cannot anchor to the checkout
# root, so this is a local-invocation default, not the enforced filter: a
# path search for "gman/" also matches this repo's own checkout directory
# (named after the repo), which is why clang-tidy.yml passes
# --header-filter/--exclude-header-filter built from $PWD instead of
# relying on this file for the workflow's own run.
HeaderFilterRegex: '(^|/)(include|libgman|libgmanray|libgmanraster|libgmanrib|shaders|renderers|gman)/'
ExcludeHeaderFilterRegex: '(^|/)(build|tests)/'
CheckOptions:
  # AGENTS.md bans the sprintf/strcpy/strcat family, bounded or not --
  # snprintf and strncpy are bounded and still banned, because the ban is
  # on a hand-sized buffer, not on an absent bound. gets is unreachable
  # from a C++20 translation unit (removed in C++14) but named here so it
  # carries this project's reason rather than the check's generic one.
  # `^::name$` matches the call regardless of an std:: qualifier: the
  # check resolves to the callee's underlying function before applying
  # the regex, so std::sprintf and a bare sprintf match the same pattern.
  bugprone-unsafe-functions.CustomFunctions: >-
    ^::sprintf$,,build strings with std::string and std::format, not a
    hand-sized buffer;
    ^::vsprintf$,,build strings with std::string and std::format, not a
    hand-sized buffer;
    ^::snprintf$,,build strings with std::string and std::format, not a
    hand-sized buffer;
    ^::vsnprintf$,,build strings with std::string and std::format, not a
    hand-sized buffer;
    ^::strcpy$,,build strings with std::string and std::format, not a
    hand-sized buffer;
    ^::strncpy$,,build strings with std::string and std::format, not a
    hand-sized buffer;
    ^::strcat$,,build strings with std::string and std::format, not a
    hand-sized buffer;
    ^::strncat$,,build strings with std::string and std::format, not a
    hand-sized buffer;
    ^::gets$,,build strings with std::string and std::format, not a
    hand-sized buffer
  # A file includes a library's public header, never its configuration
  # header: <png.h>, not <pngconf.h>. strcasecmp is POSIX with no std:: form,
  # and macOS and Linux declare it in different headers. Each entry anchors at
  # a / because clang-tidy matches it as a path suffix.
  misc-include-cleaner.IgnoreHeaders: '/pngconf\.h;/pnglibconf\.h;/tiff\.h;/tiffconf\.h;/tiffvers\.h;/jconfig\.h;/jmorecfg\.h;/zconf\.h;/_?strings\.h'
