/*
 * Generated by CMake's configure_file(gmanfiledrivers.cpp.in) -- edit that
 * template, never a build tree's copy of this file. CMake fills in each
 * driver's header include, factory and matcher when its option is ON, or
 * leaves them empty when it is OFF, so the driver table below holds no
 * preprocessor conditional of its own: whether a driver's code exists at
 * all is a configure-time decision CMake already made when it chose which
 * .cpp files to compile into gman_core.
 */

#include <format>
#include <memory>
#include <string>
#include <vector>

#include "gmanerror.h"
#include "gmanfiledrivers.h"
#include "gmanoptions.h"
#include "gmanoutput.h"
#include "gmanoutputpnm.h"
#include "gmanoutputtiff.h"
#include "gmanquantize.h"
@GMAN_PNG_INCLUDE@
@GMAN_JPEG_INCLUDE@
@GMAN_EXR_INCLUDE@

namespace {

template <typename Driver> bool isOutputOf(GMANOutput const &output) {
  return dynamic_cast<Driver const *>(&output) != nullptr;
}

std::unique_ptr<GMANOutput> gmanMakeTIFFOutput(char const *path, int width,
                                                int height) {
  return std::make_unique<gman::OutputTIFF>(path, width, height);
}

std::unique_ptr<GMANOutput> gmanMakePNMOutput(char const *path, int width,
                                               int height) {
  return std::make_unique<gman::OutputPNM>(path, width, height);
}

@GMAN_PNG_FACTORY_DEFINITION@

@GMAN_JPEG_FACTORY_DEFINITION@

@GMAN_EXR_FACTORY_DEFINITION@

// Fixed order: tiff, pnm, png, jpeg, exr. Each factory reference below is what
// keeps the linker from dropping a compiled driver's object file -- the
// table is the only caller a driver's factory needs. A matcher tells
// whether an output is that driver's class.
const std::vector<gman::FileDriverEntry> kFileDrivers = {
    {"tiff", {"tif", "tiff"}, "", "TIFF", &gmanMakeTIFFOutput,
     &isOutputOf<gman::OutputTIFF>, false, false},
    {"pnm", {"pnm"}, "", "PNM", &gmanMakePNMOutput,
     &isOutputOf<gman::OutputPNM>, false, false},
    {"png", {"png"}, "libpng", "PNG", @GMAN_PNG_FACTORY_REF@,
     @GMAN_PNG_MATCHER@, true, false},
    {"jpeg", {"jpg", "jpeg"}, "libjpeg", "JPEG", @GMAN_JPEG_FACTORY_REF@,
     @GMAN_JPEG_MATCHER@, false, false},
    {"exr", {"exr"}, "OpenEXR", "OpenEXR", @GMAN_EXR_FACTORY_REF@,
     @GMAN_EXR_MATCHER@, false, true},
};

} // namespace

namespace gman {

std::unique_ptr<GMANOutput> makeFileOutput(std::string const &extension,
                                            char const *path, int width,
                                            int height) {
  for (auto const &entry : kFileDrivers) {
    for (auto const &candidate : entry.extensions) {
      if (candidate != extension) {
        continue;
      }
      if (entry.factory == nullptr) {
        const std::string errorMsg = std::format(
            "Display \"{}\": built without {}", extension, entry.library);
        throw(GMANError(RIE_BADFILE, RIE_ERROR, errorMsg.c_str()));
      }
      return entry.factory(path, width, height);
    }
  }
  std::string errorMsg("Unrecognized Display file extension: ");
  errorMsg.append(extension);
  throw(GMANError(RIE_BADFILE, RIE_ERROR, errorMsg.c_str()));
}

FileDriverEntry const *fileDriverEntry(GMANOutput const &output) {
  for (auto const &entry : kFileDrivers) {
    if (entry.matches != nullptr && entry.matches(output)) {
      return &entry;
    }
  }
  return nullptr;
}

GMANQuantize quantizeRequest(GMANOutput const &output,
                             GMANOptions const &options) {
  GMANQuantize request = options.getColorQuantize();
  FileDriverEntry const *const entry = fileDriverEntry(output);
  if (!options.isColorQuantizeSet() && entry != nullptr &&
      entry->doesNotQuantize) {
    request.one = 0;
  }
  return request;
}

std::vector<std::string> fileDrivers() {
  std::vector<std::string> names;
  for (auto const &entry : kFileDrivers) {
    if (entry.factory != nullptr) {
      names.push_back(entry.name);
    }
  }
  return names;
}

} // namespace gman
