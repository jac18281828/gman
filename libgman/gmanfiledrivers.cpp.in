/*
 * Generated by CMake's configure_file(gmanfiledrivers.cpp.in) -- edit that
 * template, never a build tree's copy of this file. CMake fills in each
 * driver's header include and factory when its option is ON, or leaves
 * them empty when it is OFF, so the driver table below holds no
 * preprocessor conditional of its own: whether a driver's code exists at
 * all is a configure-time decision CMake already made when it chose which
 * .cpp files to compile into gman_core.
 */

#include <format>
#include <memory>
#include <string>
#include <vector>

#include "gmanerror.h"
#include "gmanfiledrivers.h" /* Declaration Header */
#include "gmanoutput.h"
#include "gmanoutputpnm.h"
#include "gmanoutputtiff.h"
@GMAN_PNG_INCLUDE@
@GMAN_JPEG_INCLUDE@

namespace {

using GMANFileDriverFactory = std::unique_ptr<GMANOutput> (*)(char const *,
                                                               int, int);

struct GMANFileDriverEntry {
  std::string name;
  std::vector<std::string> extensions;
  std::string library; // empty when the driver needs no library
  GMANFileDriverFactory factory; // null when not compiled into this build
};

std::unique_ptr<GMANOutput> gmanMakeTIFFOutput(char const *path, int width,
                                                int height) {
  return std::make_unique<GMANOutputTIFF>(path, width, height);
}

std::unique_ptr<GMANOutput> gmanMakePNMOutput(char const *path, int width,
                                               int height) {
  return std::make_unique<GMANOutputPNM>(path, width, height);
}

@GMAN_PNG_FACTORY_DEFINITION@

@GMAN_JPEG_FACTORY_DEFINITION@

// Fixed order: tiff, pnm, png, jpeg. Each factory reference below is what
// keeps the linker from dropping a compiled driver's object file -- the
// table is the only caller a driver's factory needs.
const std::vector<GMANFileDriverEntry> kFileDrivers = {
    {"tiff", {"tif", "tiff"}, "", &gmanMakeTIFFOutput},
    {"pnm", {"pnm"}, "", &gmanMakePNMOutput},
    {"png", {"png"}, "libpng", @GMAN_PNG_FACTORY_REF@},
    {"jpeg", {"jpg", "jpeg"}, "libjpeg", @GMAN_JPEG_FACTORY_REF@},
};

} // namespace

std::unique_ptr<GMANOutput> gmanMakeFileOutput(std::string const &extension,
                                                char const *path, int width,
                                                int height) {
  for (auto const &entry : kFileDrivers) {
    for (auto const &candidate : entry.extensions) {
      if (candidate != extension) {
        continue;
      }
      if (entry.factory == nullptr) {
        const std::string errorMsg = std::format(
            "Display \"{}\": built without {}", extension, entry.library);
        throw(GMANError(RIE_BADFILE, RIE_ERROR, errorMsg.c_str()));
      }
      return entry.factory(path, width, height);
    }
  }
  std::string errorMsg("Unrecognized Display file extension: ");
  errorMsg.append(extension);
  throw(GMANError(RIE_BADFILE, RIE_ERROR, errorMsg.c_str()));
}

std::vector<std::string> gmanFileDrivers() {
  std::vector<std::string> names;
  for (auto const &entry : kFileDrivers) {
    if (entry.factory != nullptr) {
      names.push_back(entry.name);
    }
  }
  return names;
}
