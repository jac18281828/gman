Display "quantize_fallback.pnm" "file" "rgba"
Format 16 16 1
Projection "orthographic"
Clipping 0.5 50
PixelFilter "box" 1 1
PixelSamples 1 1
Quantize "rgba" 65535 0 65535 0
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [1]
Color [0.25 0.25 0.25]
Surface "matte" "Ka" [1] "Kd" [0]
Polygon "P" [ -10 -10 0  10 -10 0  10 10 0  -10 10 0 ]
WorldEnd
