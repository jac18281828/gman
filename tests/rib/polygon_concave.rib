Display "polygon_concave.tif" "file" "rgba"
Format 200 200 1
Projection "perspective" "fov" [90]
# Explicit, not the RI_EPSILON-near default: SPEC.md Section 8's near-clip
# precision defect corrupts geometry flat or narrow in z hardest, and a
# camera-facing planar polygon is exactly that shape.
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [0.3]
Sides 2
Color [0.8 0.4 0.2]
Surface "matte" "Ka" [1.0]
# An L-shape (gnomon): one reflex vertex at (0,0,0). Vertex 0 sits where
# the fan's own diagonals cross the notch the L is missing -- a different
# vertex 0 can leave every diagonal inside by coincidence, as a square
# corner does, so this ordering is chosen, not incidental.
Polygon "P" [1 -1 0  1 0 0  0 0 0  0 1 0  -1 1 0  -1 -1 0]
WorldEnd
