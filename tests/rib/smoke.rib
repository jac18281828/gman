## One small scene for every installed renderer: a plastic sphere on a matte
## floor under one distant light. Not third-party.
Display "smoke.tif" "file" "rgba"
Format 40 30 1
PixelSamples 1 1
Projection "perspective" "fov" [45]
Clipping 0.5 50
Option "pathtracer" "integer samples" [2]
Translate 0 0 5
WorldBegin
LightSource "distantlight" 1 "intensity" [1] "from" [0 4 -3] "to" [0 0 0]
Surface "matte"
Polygon "P" [-3 -1 -2  3 -1 -2  3 -1 4  -3 -1 4]
Surface "plastic"
Sphere 1 -1 1 360
WorldEnd
