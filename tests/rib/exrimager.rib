## An OpenEXR Display with no Quantize under Imager "background" writes float
## samples. The imager adds its backdrop scaled by 1 - alpha, which is 0 at
## full coverage, so the covered half plane still reads exactly 3.0.
Display "exrimager.exr" "file" "rgba"
Format 16 16 1
Projection "orthographic"
Clipping 0.5 50
Imager "background" "background" [0.2 0.3 0.4]
PixelFilter "box" 1 1
PixelSamples 1 1
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [4]
Color [0.75 0.75 0.75]
Surface "matte" "Ka" [1] "Kd" [0]
Polygon "P" [ -10 -10 0  -0.03 -10 0  -0.03 10 0  -10 10 0 ]
WorldEnd
