## nupatch_texturecoordinates.rib's own twin, with no TextureCoordinates
## at all: since getRSNuPatch always passes kIdentityCorners regardless
## of what RiTextureCoordinates supplies, the two must render bit-for-bit
## the same.
Display "nupatch_texturecoordinates_default.tif" "file" "rgba"
Format 200 200 1
Projection "perspective" "fov" [90]
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [0.3]
Sides 2
Color [1 1 1]
Surface "paintedplastic" "Ka" [1.0] "Kd" [0.0] "Ks" [0.0]
	"texturename" ["checker_texture.tif"]
TransformBegin
	Translate 100 100 0
	Sphere 1 -1 1 360
TransformEnd
NuPatch 2 2 [0 0 1 1] 0 1 2 2 [0 0 1 1] 0 1
	"P" [-1 -1 0  1 -1 0  -1 1 0  1 1 0]
WorldEnd
