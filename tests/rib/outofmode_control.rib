# A lit sphere with no request out of mode: the image the other fixtures must match.
# Read by tests/outofmode_test.cpp.
Display "outofmode_control.tif" "file" "rgba"
Format 32 32 1
Projection "perspective" "fov" [45]
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [0.2]
LightSource "distantlight" 2 "intensity" [1.0] "from" [5 3 0] "to" [0 0 0]
Sphere 1 -1 1 360
WorldEnd
