## The far half of such a prism, seen and lit from inside, the side opposite its vertex normals
## (tests/shadowterminator_test.cpp). Not third-party.
Display "shadowterminator_backside.tif" "file" "rgba"
Format 64 64 1
Projection "orthographic"
ScreenWindow -1 1 -1 1
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "distantlight" 1 "intensity" [1] "from" [0 0 0] "to" [0 0 1]
Surface "matte" "Ka" [0] "Kd" [1]
PointsPolygons [4 4 4 4]
	[0 2 3 1 2 4 5 3 4 6 7 5 6 8 9 7]
	"P" [-0.75 -0.75 0 -0.75 0.75 0 -0.530330086 -0.75 0.530330086 -0.530330086 0.75 0.530330086 0 -0.75 0.75 0 0.75 0.75 0.530330086 -0.75 0.530330086 0.530330086 0.75 0.530330086 0.75 -0.75 0 0.75 0.75 0]
	"N" [-1 0 0 -1 0 0 -0.707106781 0 0.707106781 -0.707106781 0 0.707106781 0 0 1 0 0 1 0.707106781 0 0.707106781 0.707106781 0 0.707106781 1 0 0 1 0 0]
TransformBegin
	Translate 100 100 0
	Sphere 1 -1 1 360
TransformEnd
WorldEnd
