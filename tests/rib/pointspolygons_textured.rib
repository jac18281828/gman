# Two faces sharing an edge (points 1 and 4), a per-point "st" read
# through each face's own "verts" entry, against polygons_textured.rib's
# own two Polygon requests carrying the same per-vertex "st" directly.
# Surfaced with paintedplastic reading tests/checkertexture.h's checker,
# the same fixture texcoords_test.cpp writes.
Display "pointspolygons_textured.tif" "file" "rgba"
Format 200 200 1
Projection "perspective" "fov" [90]
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [0.3]
Sides 2
Color [1 1 1]
Surface "paintedplastic" "Ka" [1.0] "Kd" [0.0] "Ks" [0.0]
	"texturename" ["checker_texture.tif"]
Translate -1 1 0
Scale 1 -2 1
PointsPolygons [4 4] [0 1 4 3  1 2 5 4]
	"P" [0 0 0  1 0 0  2 0 0  0 1 0  1 1 0  2 1 0]
	"st" [0 0  1 0  0 0  0 1  1 1  0 1]
WorldEnd
