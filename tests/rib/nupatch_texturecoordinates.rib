## Pins the out-of-scope decision that RiTextureCoordinates never changes
## a NuPatch's render: getRSNuPatch always passes kIdentityCorners
## regardless of what was supplied. An order-2x2 NuPatch (nu=nv=2, knots
## [0 0 1 1]) over the same "P" and the same camera, lighting, Sides 2
## and paintedplastic/checker-texture surface as
## tests/rib/texcoords/patch_texturecoordinates.rib, carrying that
## fixture's own corner transpose. See
## nupatch_texturecoordinates_default.rib, its own twin with no
## TextureCoordinates at all -- the two must render bit-for-bit the same.
Display "nupatch_texturecoordinates.tif" "file" "rgba"
Format 200 200 1
Projection "perspective" "fov" [90]
# Explicit, not the RI_EPSILON-near default: the near-clip
# precision defect corrupts geometry flat or narrow in z hardest, and a
# camera-facing planar patch is exactly that shape.
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [0.3]
Sides 2
Color [1 1 1]
Surface "paintedplastic" "Ka" [1.0] "Kd" [0.0] "Ks" [0.0]
	"texturename" ["checker_texture.tif"]
# Desync convention: a Surface that mis-counts its own "texturename"
# parameter desyncs the token stream, and that failure surfaces as this
# following request failing to parse -- pushed far outside the view
# frustum so it never reaches the frame the pixel assertions read.
TransformBegin
	Translate 100 100 0
	Sphere 1 -1 1 360
TransformEnd
# Transpose: (0,0)->(0,0), (1,0)->(0,1), (0,1)->(1,0), (1,1)->(1,1).
TextureCoordinates 0 0  0 1  1 0  1 1
NuPatch 2 2 [0 0 1 1] 0 1 2 2 [0 0 1 1] 0 1
	"P" [-1 -1 0  1 -1 0  -1 1 0  1 1 0]
WorldEnd
