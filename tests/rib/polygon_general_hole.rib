Display "polygon_general_hole.tif" "file" "rgba"
Format 200 200 1
Projection "perspective" "fov" [90]
# Explicit, not the RI_EPSILON-near default: the near-clip
# precision defect corrupts geometry flat or narrow in z hardest, and a
# camera-facing planar polygon is exactly that shape.
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [0.3]
Sides 2
Color [0.8 0.4 0.2]
Surface "matte" "Ka" [1.0]
# A square with a square hole cut from its centre: the hole must render as
# background, not fill.
GeneralPolygon [4 4] "P" [-1 -1 0  1 -1 0  1 1 0  -1 1 0
                          -0.4 -0.4 0  -0.4 0.4 0  0.4 0.4 0  0.4 -0.4 0]
WorldEnd
