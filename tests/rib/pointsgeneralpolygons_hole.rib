# One PointsGeneralPolygons face, two loops (an outer square and a square
# hole) read through "verts" out of a shared "P" -- against
# generalpolygon_hole_twin.rib's own equivalent GeneralPolygon, whose "P"
# already carries the same eight points in the same loop order directly.
Display "pointsgeneralpolygons_hole.tif" "file" "rgba"
Format 200 200 1
Projection "perspective" "fov" [90]
Clipping 0.5 50
Translate 0 0 5
WorldBegin
# "from"/"to" sit off this camera-facing plane's own N.L=0 plane, unlike
# r5a_disk.rib/r5a_polygon.rib's oblique light: that angle's strong -z tilt
# aligns this flat, tight-roughness (0.08) plastic's mirror-like specular
# reflection with the camera across the whole face, saturating it to pure
# white -- a worse collision than the one being fixed. A shallow -z tilt
# keeps the specular term off that alignment while still lifting N.L off
# zero.
LightSource "ambientlight" 1 "intensity" [0.1]
LightSource "distantlight" 2 "intensity" [1.0] "lightcolor" [1 1 1]
	"from" [5 0 -1] "to" [0 0 0]
Sides 2
Surface "plastic" "Ka" [0.2] "Kd" [0.7] "Ks" [0.6] "roughness" [0.08]
	"specularcolor" [1 1 1]
PointsGeneralPolygons [2] [4 4] [0 1 2 3  4 5 6 7]
	"P" [-1 -1 0  1 -1 0  1 1 0  -1 1 0
	     -0.5 -0.5 0  0.5 -0.5 0  0.5 0.5 0  -0.5 0.5 0]
WorldEnd
