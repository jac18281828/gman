## A half-prism with radial vertex normals under one grazing distant light, its surface naming a normal map
## (tests/bumpterminator_test.cpp). Not third-party.
Display "bumpterminator.tif" "file" "rgba"
Format 64 64 1
Projection "orthographic"
ScreenWindow -1 1 -1 1
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "distantlight" 1 "intensity" [1] "from" [1 0 0] "to" [0 0 0]
Surface "paintedplastic" "Ka" [0] "Kd" [1] "Ks" [0]
	"string normalname" ["bumpterminator_tilt.tif"]
PointsPolygons [4 4 4 4 4]
	[0 2 3 1  2 4 5 3  4 6 7 5  6 8 9 7  8 10 11 9]
	"P" [-0.717705252 -0.75 0.217713508 -0.717705252 0.75 0.217713508 -0.661440948 -0.75 -0.353547553 -0.661440948 0.75 -0.353547553 -0.217713508 -0.75 -0.717705252 -0.217713508 0.75 -0.717705252 0.353547553 -0.75 -0.661440948 0.353547553 0.75 -0.661440948 0.717705252 -0.75 -0.217713508 0.717705252 0.75 -0.217713508 0.661440948 -0.75 0.353547553 0.661440948 0.75 0.353547553]
	"N" [-0.956940336 0 0.290284677 -0.956940336 0 0.290284677 -0.881921264 0 -0.471396737 -0.881921264 0 -0.471396737 -0.290284677 0 -0.956940336 -0.290284677 0 -0.956940336 0.471396737 0 -0.881921264 0.471396737 0 -0.881921264 0.956940336 0 -0.290284677 0.956940336 0 -0.290284677 0.881921264 0 0.471396737 0.881921264 0 0.471396737]
	"st" [0 0  0 1  0.2 0  0.2 1  0.4 0  0.4 1  0.6 0  0.6 1  0.8 0  0.8 1  1 0  1 1]
TransformBegin
	Translate 100 100 0
	Sphere 1 -1 1 360
TransformEnd
WorldEnd
