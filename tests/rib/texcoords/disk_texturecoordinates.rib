Display "disk_texturecoordinates.tif" "file" "rgba"
Format 200 200 1
Projection "perspective" "fov" [90]
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [0.3]
Sides 2
Color [1 1 1]
Surface "paintedplastic" "Ka" [1.0] "Kd" [0.0] "Ks" [0.0]
	"texturename" ["checker_texture.tif"]
TransformBegin
	Translate 100 100 0
	Sphere 1 -1 1 360
TransformEnd
# Every corner (0,0),(1,0),(0,1),(1,1) maps to the same (0.75, 0.75): a
# Disk's bilinear corner blend is then constant, so every grid vertex
# samples the white texel regardless of its own (u, v).
TextureCoordinates 0.75 0.75  0.75 0.75  0.75 0.75  0.75 0.75
Disk 0 1 360
WorldEnd
