Display "lights.tif" "file" "rgba"
Format 640 480 1
Projection "perspective" "fov" [45]
# Explicit, not the RI_EPSILON-near default: the near plane's offset term
# in the projection matrix is astronomically small next to a scene-scale
# z (~5), which RtFloat (32-bit) cannot represent -- z_clip and w_clip
# become indistinguishable, and the back-plane clip test degenerates to
# noise. See phase-3-REPORT.md.
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [0.1]
LightSource "distantlight" 2 "intensity" [1.0] "lightcolor" [1 1 1]
	"from" [5 0 0] "to" [0 0 0]
Sides 1
Surface "plastic" "Ka" [0.2] "Kd" [0.7] "Ks" [0.6] "roughness" [0.08]
	"specularcolor" [1 1 1]
Sphere 1 -1 1 360
WorldEnd
