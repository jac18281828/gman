## A matte sphere inside a closed, inward-facing box enclosing the camera
## too, lit by one point light and no ambient light, naming the radiosity
## pass: brightens the box's own shadowed side relative to
## radiosity_box_off.rib, which names no pass. Not third-party.
Display "radiosity_box.tif" "file" "rgba"
Format 24 24 1
Projection "perspective" "fov" [45]
Clipping 0.5 50
Option "render" "string indirect" ["radiosity"]
Option "radiosity" "float elementsize" [4.0]
Translate 0 0 5
WorldBegin
LightSource "pointlight" 1 "intensity" [4] "from" [0 2 -3]

Surface "matte" "Ka" [1] "Kd" [1]
Color [0.8 0.8 0.8]
Opacity [1 1 1]

Polygon "P" [-4 -4 -6  4 -4 -6  4 4 -6  -4 4 -6]
Polygon "P" [-4 -4 6  -4 4 6  4 4 6  4 -4 6]
Polygon "P" [-4 -4 -6  -4 -4 6  -4 4 6  -4 4 -6]
Polygon "P" [4 -4 -6  4 4 -6  4 4 6  4 -4 6]
Polygon "P" [-4 -4 -6  4 -4 -6  4 -4 6  -4 -4 6]
Polygon "P" [-4 4 -6  -4 4 6  4 4 6  4 4 -6]

Color [0.9 0.9 0.9]
Sphere 1.2 -1.2 1.2 360
WorldEnd
