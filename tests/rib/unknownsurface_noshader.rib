Display "unknownsurface_noshader.tif" "file" "rgba"
Format 160 120 1
Projection "perspective" "fov" [45]
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [0.2]
LightSource "distantlight" 2 "intensity" [1.0] "from" [5 3 0] "to" [0 0 0]
Surface "plastic"
Surface "gmanzbuffer" "Kd" [0.2]
Sphere 1 -1 1 360
WorldEnd
