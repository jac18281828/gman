## One curved bicubic Bezier Patch, lit by ambient and distant light under
## plastic: the ray renderers draw it, and its coverage matches the z-buffer's.
##
## A trailing Sphere follows AGENTS.md's "RIB authoring" section, "The
## desync convention."
Display "patch_bicubic_curved.tif" "file" "rgba"
Format 200 200 1
Projection "perspective" "fov" [45]
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [0.2]
LightSource "distantlight" 2 "intensity" [0.8] "lightcolor" [1 1 1]
	"from" [-2 2 -3] "to" [0 0 0]
Sides 2
Surface "plastic" "Ka" [0.2] "Kd" [0.7] "Ks" [0.5] "roughness" [0.1]
	"specularcolor" [1 1 1]
Patch "bicubic" "P" [
	-1.0 -1.0  0.6   -1.0 -0.333  0.1   -1.0 0.333  0.1   -1.0 1.0  0.6
	-0.333 -1.0  0.1   -0.333 -0.333 -0.5  -0.333 0.333 -0.5  -0.333 1.0  0.1
	0.333 -1.0  0.1    0.333 -0.333 -0.5   0.333 0.333 -0.5   0.333 1.0  0.1
	1.0 -1.0  0.6      1.0 -0.333  0.1    1.0 0.333  0.1     1.0 1.0  0.6
]
AttributeBegin
	Translate 1.5 -1.5 0
	Sphere 0.3 -0.3 0.3 360
AttributeEnd
WorldEnd
