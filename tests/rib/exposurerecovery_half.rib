Display "exposurerecovery_half.tif" "file" "rgba"
Format 16 16 1
Projection "orthographic"
Clipping 0.5 50
PixelFilter "box" 1 1
PixelSamples 1 1
Exposure 0.5 1
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [2]
Color [0.8 0.8 0.8]
Surface "matte" "Ka" [1] "Kd" [0]
Polygon "P" [ -10 -10 0  10 -10 0  10 10 0  -10 10 0 ]
WorldEnd
