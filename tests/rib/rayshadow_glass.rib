## A matte sphere under a clear glass slab, lit by one distant light from above. Each face
## of the slab passes 0.96 of the light at normal incidence. Not third-party.
Display "rayshadow_glass.tif" "file" "rgba"
Format 320 240 1
PixelSamples 2 2
Option "pathtracer" "integer samples" [64]
Projection "perspective" "fov" [40]
Clipping 0.5 50
Translate 0 0 5
Rotate -20 1 0 0
WorldBegin
LightSource "distantlight" 1 "from" [0 10 0] "to" [0 0 0] "intensity" [1]
Surface "matte"
Sphere 1 -1 1 360
AttributeBegin
Surface "glass"
Polygon "P" [-2 2 -2  2 2 -2  2 2 2  -2 2 2]
Polygon "P" [-2 2.1 2  2 2.1 2  2 2.1 -2  -2 2.1 -2]
AttributeEnd
WorldEnd
