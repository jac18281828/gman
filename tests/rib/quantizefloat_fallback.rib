## Quantize "rgba" 0 to a PNM Display: the driver cannot write float, so
## it warns once and quantizes with 255 0 255.
Display "quantizefloat_fallback.pnm" "file" "rgba"
Format 16 16 1
Projection "orthographic"
Clipping 0.5 50
PixelFilter "box" 1 1
PixelSamples 1 1
Quantize "rgba" 0 0 0 0
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [1]
Color [0.25 0.25 0.25]
Surface "matte" "Ka" [1] "Kd" [0]
Polygon "P" [ -10 -10 0  10 -10 0  10 10 0  -10 10 0 ]
WorldEnd
