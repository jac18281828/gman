Display "polygon.tif" "file" "rgba"
Format 200 200 1
Projection "perspective" "fov" [90]
# Explicit, not the RI_EPSILON-near default: SPEC.md Section 8's near-clip
# precision defect corrupts geometry flat or narrow in z hardest, and a
# camera-facing planar polygon is exactly that shape.
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [0.3]
Sides 2
Color [0.8 0.4 0.2]
Surface "matte" "Ka" [1.0]
# A convex, regular pentagon -- five vertices, not four, since a 4-vertex
# fixture cannot distinguish RiPolygonV's parameter-list sizing fix from
# the bug it fixes (the old hardcoded 4,4 is right for a quad by
# coincidence). Convex on purpose, so this stays the triangulator's easy
# case; polygon_concave.rib and its siblings cover concave, collinear and
# reversed-winding input.
Polygon "P" [0 1 0  -0.9510565 0.3090170 0  -0.5877853 -0.8090170 0
             0.5877853 -0.8090170 0  0.9510565 0.3090170 0]
WorldEnd
