Display "r8_glass.tif" "file" "rgba"
Format 200 150 1
Projection "perspective" "fov" [45]
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [0.6]
Sides 1

# A two-tone backdrop, its edge off the sphere's own centre column (world
# x = 1, not 0) -- an edge centred behind the sphere would not move, by
# symmetry, regardless of refraction. Lit ambient alone:
# GMANSurfaceEnv::ambient() is never shadowed, sidestepping glass's own
# shadow rays (which treat it as fully opaque).
AttributeBegin
Identity
Translate 0 0 15
Surface "matte" "Ka" [1] "Kd" [0]
Color [0.9 0.2 0.2]
Opacity [1 1 1]
Sides 2
Polygon "P" [-10 -10 0  1 -10 0  1 10 0  -10 10 0]
AttributeEnd

AttributeBegin
Identity
Translate 0 0 15
Surface "matte" "Ka" [1] "Kd" [0]
Color [0.2 0.2 0.9]
Opacity [1 1 1]
Sides 2
Polygon "P" [1 -10 0  10 -10 0  10 10 0  1 10 0]
AttributeEnd

AttributeBegin
Surface "glass"
Color [1 1 1]
Opacity [1 1 1]
Sphere 1.5 -1.5 1.5 360
AttributeEnd

WorldEnd
