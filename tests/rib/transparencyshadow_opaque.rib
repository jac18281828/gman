## R-transparency proof, check 4: one fully opaque blocker -- the darkest
## of the four shadow-attenuation fixtures. Not third-party.
Display "transparencyshadow_opaque.tif" "file" "rgba"
Format 320 240 1
Projection "perspective" "fov" [45]
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [0.04]
LightSource "distantlight" 2 "intensity" [1.45] "lightcolor" [1 1 1]
	"from" [5 2 -3] "to" [0 0 0]
Sides 1
Surface "matte" "Ka" [0.2] "Kd" [0.8]

AttributeBegin
	Translate 0 0 7
	Sphere 3 -3 3 360
AttributeEnd

AttributeBegin
	Translate 1.8 0.8 3.5
	Sphere 0.6 -0.6 0.6 360
AttributeEnd
WorldEnd
