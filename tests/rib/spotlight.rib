Display "spotlight.tif" "file" "rgba"
Format 200 200 1
Projection "perspective" "fov" [45]
# Explicit, not the RI_EPSILON-near default -- see tests/rib/lights.rib's
# own comment on this.
Clipping 0.5 50
Translate 0 0 5
WorldBegin
# The light sits on the disk's own axis, coneangle radians wide, so radius
# from the disk's centre maps directly to the cone's own angle: inside the
# cone near the centre, outside it toward the rim, with a tapered band at
# "coneangle - conedeltaangle" in between.
LightSource "spotlight" 1 "intensity" [30] "from" [0 0 0] "to" [0 0 1]
	"coneangle" [0.3] "conedeltaangle" [0.08] "beamdistribution" [6]
ReverseOrientation
Surface "matte" "Ka" [0] "Kd" [1]
Disk 5 3 360
WorldEnd
