# shinymetal with no texturename skips the environment lookup and adds
# black, degrading to metal (RISpec: an implementation without
# environment mapping behaves this way). Paired with metal_reference.rib,
# which renders the same scene with metal and the same Ka/Ks/roughness.
Display "shinymetal_degrades.tif" "file" "rgba"
Format 200 200 1
Projection "perspective" "fov" [45]
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [0.1]
LightSource "distantlight" 2 "intensity" [1.0] "lightcolor" [1 1 1]
	"from" [5 0 0] "to" [0 0 0]
Sides 1
Surface "shinymetal" "Ka" [0.2] "Ks" [0.6] "Kr" [1] "roughness" [0.08]
Sphere 1 -1 1 360
WorldEnd
