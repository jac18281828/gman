## contactshadow.rib with the vertical blocker
## removed -- the receiver's own unshadowed brightness, everywhere the
## blocked version should darken once its shadow reaches contact.
## Not third-party.
Display "contactshadow_noblocker.tif" "file" "rgba"
Format 640 480 1
Projection "perspective" "fov" [6]
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [0.1]
LightSource "distantlight" 2 "intensity" [15.0] "lightcolor" [1 1 1]
	"from" [50 3 0] "to" [0 0 0]
Surface "matte" "Ka" [0.2] "Kd" [0.8]

Polygon "P" [-0.5 -0.05 -3  -0.5 -0.05 3  0.5 -0.05 3  0.5 -0.05 -3]
WorldEnd
