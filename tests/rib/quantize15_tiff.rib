## Quantize "rgba" 15 0 15 0.5 to a TIFF Display: a request the driver can
## store is honoured exactly, writing 0 to 15 into 8-bit samples.
Display "quantize15_tiff.tif" "file" "rgba"
Format 16 16 1
Projection "orthographic"
Clipping 0.5 50
PixelFilter "box" 1 1
PixelSamples 1 1
Quantize "rgba" 15 0 15 0.5
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [1]
Color [1 1 1]
Surface "matte" "Ka" [1] "Kd" [0]
Polygon "P" [ -10 -10 0  -0.03 -10 0  -0.03 10 0  -10 10 0 ]
WorldEnd
