## Fixture 1, "Two surfaces, one shader": two plastic spheres,
## each its own AttributeBegin/AttributeEnd block, Kd 0.1 at x=-1.2 and
## Kd 1.0 at x=1.2. Ks 0 and no ambient light make brightness linear in
## Kd, so a correct render puts the dim sphere's red channel near a tenth
## of the bright one's, under either renderer. The z-buffer shades each
## sphere as it is created, so it always gets this right; a ray tracer
## that shades every primitive only after both Surface calls ran, with
## the last one's list, would not. Not third-party.
Display "surfaceparameters_two_surfaces.tif" "file" "rgba"
Format 200 100 1
Projection "perspective" "fov" [45]
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "distantlight" 1 "intensity" [1.0] "lightcolor" [1 1 1]
	"from" [0 0 -5] "to" [0 0 0]
AttributeBegin
	Translate -1.2 0 0
	Surface "plastic" "Kd" [0.1] "Ks" [0]
	Sphere 1 -1 1 360
AttributeEnd
AttributeBegin
	Translate 1.2 0 0
	Surface "plastic" "Kd" [1.0] "Ks" [0]
	Sphere 1 -1 1 360
AttributeEnd
WorldEnd
