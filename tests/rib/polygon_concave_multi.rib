Display "polygon_concave_multi.tif" "file" "rgba"
Format 200 200 1
Projection "perspective" "fov" [90]
# Explicit, not the RI_EPSILON-near default: SPEC.md Section 8's near-clip
# precision defect corrupts geometry flat or narrow in z hardest, and a
# camera-facing planar polygon is exactly that shape.
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [0.3]
Sides 2
Color [0.8 0.4 0.2]
Surface "matte" "Ka" [1.0]
# A 4-pointed star: four reflex vertices (the inner points), not one --
# an ear blocked by a single reflex vertex is the easy case; blocked by
# several at once, each ear candidate's containment test has more than
# one vertex that could be sitting inside it.
Polygon "P" [1.0000 0.0000 0    0.2475 0.2475 0    0.0000 1.0000 0
             -0.2475 0.2475 0   -1.0000 0.0000 0   -0.2475 -0.2475 0
             0.0000 -1.0000 0   0.2475 -0.2475 0]
WorldEnd
