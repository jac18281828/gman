## A translucent red sphere before a green wall, seen directly and in a mirror of Kr 0.8; under the ray tracer alone,
## since the path tracer reads no ambientlight. Not third-party.
Display "raycomposite_ambient.tif" "file" "rgba"
Format 64 48 1
PixelSamples 2 2
Projection "perspective" "fov" [40]
Clipping 0.5 50
Translate 0 0 6
WorldBegin
LightSource "ambientlight" 1 "intensity" [1]
AttributeBegin
Color [0.1 1 0.1]
Surface "matte"
Polygon "P" [-8 -6 4  8 -6 4  8 6 4  -8 6 4]
Polygon "P" [-4 -6 -6  -4 -6 6  -4 6 6  -4 6 -6]
AttributeEnd
AttributeBegin
Translate -1.2 0 0
Color [1 0.1 0.1]
Opacity [0.5 0.5 0.5]
Surface "matte"
Sphere 0.8 -0.8 0.8 360
AttributeEnd
AttributeBegin
Surface "mirror" "Kr" [0.8]
Polygon "P" [0.54 -1.5 2.06  2.66 -1.5 -0.06  2.66 1.5 -0.06  0.54 1.5 2.06]
AttributeEnd
WorldEnd
