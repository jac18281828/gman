# pointsgeneralpolygons_hole.rib's own twin: the same outer square and
# hole, the same loop order, issued as one plain GeneralPolygon carrying
# "P" directly instead of reading it through a shared, indexed "P". See
# that file's own comment.
Display "generalpolygon_hole_twin.tif" "file" "rgba"
Format 200 200 1
Projection "perspective" "fov" [90]
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [0.1]
LightSource "distantlight" 2 "intensity" [1.0] "lightcolor" [1 1 1]
	"from" [5 0 0] "to" [0 0 0]
Sides 2
Surface "plastic" "Ka" [0.2] "Kd" [0.7] "Ks" [0.6] "roughness" [0.08]
	"specularcolor" [1 1 1]
GeneralPolygon [4 4]
	"P" [-1 -1 0  1 -1 0  1 1 0  -1 1 0
	     -0.5 -0.5 0  0.5 -0.5 0  0.5 0.5 0  -0.5 0.5 0]
WorldEnd
