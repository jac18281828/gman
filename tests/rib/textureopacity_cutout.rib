## A red paintedplastic card, its "opacityname" map 0 over the left half of s
## and 1 over the right, in front of a green matte backdrop. The light travels
## +x as it travels +z, so the card's shadow lands to the right of the
## backdrop pixels behind the card's cut-out half. Not third-party.
Display "textureopacity_cutout.tif" "file" "rgba"
Format 200 200 1
Projection "perspective" "fov" [90]
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "distantlight" 1 "intensity" [1.5] "lightcolor" [1 1 1]
	"from" [-5 0 -5] "to" [0 0 0]
Sides 2
Color [1 0 0]
Surface "paintedplastic" "Ka" [0] "Kd" [0.8] "Ks" [0]
	"string opacityname" ["textureopacity_half.tif"]
TransformBegin
	Translate 100 100 0
	Sphere 1 -1 1 360
TransformEnd
Polygon "P" [-1 -1 0  1 -1 0  1 1 0  -1 1 0]
	"st" [0 0  1 0  1 1  0 1]
Color [0 1 0]
Surface "matte" "Ka" [0] "Kd" [0.8]
Polygon "P" [-30 -30 3  30 -30 3  30 30 3  -30 30 3]
WorldEnd
