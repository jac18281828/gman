# PointsPolygons branch: verts reaches vertex 2, so "P" declares three points
# (nine floats) and supplies eight. A shortfall of one value stops the file
# with RIE_CONSISTENCY, as a shortfall of millions does.
#
# A trailing Sphere follows AGENTS.md's "RIB authoring" section, "The
# desync convention."
Display "malformed_out.tif" "file" "rgba"
Format 200 200 1
Projection "perspective" "fov" [45]
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [0.6]
Surface "matte" "Ka" [1] "Kd" [0]
AttributeBegin
	PointsPolygons [3] [0 1 2]
		"P" [-1 -1 0  1 -1 0  1 1]
AttributeEnd
AttributeBegin
	Translate 2 0 0
	Sphere 0.5 -0.5 0.5 360
AttributeEnd
WorldEnd
