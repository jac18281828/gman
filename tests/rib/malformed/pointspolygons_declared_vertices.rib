# PointsPolygons branch: verts reaches vertex 2000000, so the request declares
# 2000001 points (6000003 floats) for "P", which supplies three points (nine
# floats). A file this small once held 76 MB and rendered the remainder as
# zeros; gman now stops it with RIE_CONSISTENCY before "P" allocates.
#
# A trailing Sphere follows AGENTS.md's "RIB authoring" section, "The
# desync convention."
Display "malformed_out.tif" "file" "rgba"
Format 200 200 1
Projection "perspective" "fov" [45]
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [0.6]
Surface "matte" "Ka" [1] "Kd" [0]
AttributeBegin
	PointsPolygons [3] [0 1 2000000]
		"P" [-1 -1 0  1 -1 0  1 1 0]
AttributeEnd
AttributeBegin
	Translate 2 0 0
	Sphere 0.5 -0.5 0.5 360
AttributeEnd
WorldEnd
