# verts' own point count is 1 + max(verts) = 4 (twelve floats); "P"
# supplies only three points (nine floats). gman is expected to warn,
# clamp and keep going rather than read past "P"'s own allocation.
#
# A trailing Sphere follows AGENTS.md's "RIB authoring" section, "The
# desync convention."
Display "malformed_out.tif" "file" "rgba"
Format 200 200 1
Projection "perspective" "fov" [45]
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [0.6]
Surface "matte" "Ka" [1] "Kd" [0]
AttributeBegin
	PointsPolygons [4] [0 1 2 3]
		"P" [-1 -1 0  1 -1 0  1 1 0]
AttributeEnd
AttributeBegin
	Translate 2 0 0
	Sphere 0.5 -0.5 0.5 360
AttributeEnd
WorldEnd
