# nloops [1 1] declares an nverts array of length 2 (its own sum); this
# supplies 1. parsePointsGeneralPolygons's own structural check -- nverts'
# actual length against nloops' sum -- catches it before
# RiPointsGeneralPolygonsV ever sees the mismatched arrays, and calls
# nothing.
#
# A trailing Sphere follows AGENTS.md's "RIB authoring" section, "The
# desync convention."
Display "malformed_out.tif" "file" "rgba"
Format 200 200 1
Projection "perspective" "fov" [45]
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [0.6]
Surface "matte" "Ka" [1] "Kd" [0]
AttributeBegin
	PointsGeneralPolygons [1 1] [4] [0 1 2 3  4 5 6 7]
		"P" [-1 -1 0  1 -1 0  1 1 0  -1 1 0
		     -0.4 -0.4 0  -0.4 0.4 0  0.4 0.4 0  0.4 -0.4 0]
AttributeEnd
AttributeBegin
	Translate 2 0 0
	Sphere 0.5 -0.5 0.5 360
AttributeEnd
WorldEnd
