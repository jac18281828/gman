# PatchMesh branch: a bilinear mesh of 2000 by 1500 points declares three
# million vertices (nine million floats) for a "P" that supplies four points.
# The product fits RtInt, so no range error applies; gman stops the file with
# RIE_CONSISTENCY before "P" allocates.
#
# A trailing Sphere follows AGENTS.md's "RIB authoring" section, "The
# desync convention."
Display "malformed_out.tif" "file" "rgba"
Format 200 200 1
Projection "perspective" "fov" [45]
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [0.6]
Surface "matte" "Ka" [1] "Kd" [0]
AttributeBegin
	PatchMesh "bilinear" 2000 "nonperiodic" 1500 "nonperiodic" "P" [
		-0.4 -0.2 0  0.4 -0.2 0  -0.4 0.2 0  0.4 0.2 0
	]
AttributeEnd
AttributeBegin
	Translate 2 0 0
	Sphere 0.5 -0.5 0.5 360
AttributeEnd
WorldEnd
