# nloops [1] and nverts [4] declare a verts array of length 4 (nverts' own
# sum); this supplies 5. parsePointsGeneralPolygons's own structural check
# -- verts' actual length against nverts' sum -- stops the file with
# RIE_CONSISTENCY before RiPointsGeneralPolygonsV ever sees the mismatched
# arrays. "P" holds a point for every index in verts, so only the length
# rule fires.
#
# A trailing Sphere follows AGENTS.md's "RIB authoring" section, "The
# desync convention."
Display "malformed_out.tif" "file" "rgba"
Format 200 200 1
Projection "perspective" "fov" [45]
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [0.6]
Surface "matte" "Ka" [1] "Kd" [0]
AttributeBegin
	PointsGeneralPolygons [1] [4] [0 1 2 3 0]
		"P" [-1 -1 0  1 -1 0  1 1 0  -1 1 0]
AttributeEnd
AttributeBegin
	Translate 2 0 0
	Sphere 0.5 -0.5 0.5 360
AttributeEnd
WorldEnd
