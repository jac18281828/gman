# A negative nverts entry: RiGeneralPolygonV rejects it before sizing the
# parameter list, warns naming the request and the offending value, and
# adds the empty stub to the world instead of indexing "P" by a negative
# count.
#
# A trailing Sphere follows AGENTS.md's "RIB authoring" section, "The
# desync convention."
Display "malformed_out.tif" "file" "rgba"
Format 200 200 1
Projection "perspective" "fov" [45]
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [0.6]
Surface "matte" "Ka" [1] "Kd" [0]
AttributeBegin
	GeneralPolygon [4 -1] "P" [
		-1 -1 0  1 -1 0  1 1 0  -1 1 0
	]
AttributeEnd
AttributeBegin
	Translate 2 0 0
	Sphere 0.5 -0.5 0.5 360
AttributeEnd
WorldEnd
