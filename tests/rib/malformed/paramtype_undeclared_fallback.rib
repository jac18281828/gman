# A token never declared by RiDeclare or an inline declaration.
# GMANDictionary::getTokenId throws RIE_BADTOKEN; GMANParameterList reports
# it, and gman's error handler prints "ERROR: RIE_BADTOKEN --
# GMANDictionary: TOKEN_NOT_FOUND" and stops the file: exit failure, no
# crash, no RIE_SYNTAX.
#
# A trailing Sphere follows AGENTS.md's "RIB authoring" section, "The
# desync convention."
Display "malformed_out.tif" "file" "rgba"
Format 200 200 1
Projection "perspective" "fov" [45]
Clipping 0.5 50
Translate 0 0 5
WorldBegin
Surface "plastic" "nosuchtoken" [4]
Sphere 0.5 -0.5 0.5 360
WorldEnd
