# GeneralPolygon branch: nverts [4 1500000] declares a hole loop of 1500000
# vertices, 1500004 points (4500012 floats) in all, for a "P" that supplies
# four points. gman stops the file with RIE_CONSISTENCY before "P" allocates.
#
# A trailing Sphere follows AGENTS.md's "RIB authoring" section, "The
# desync convention."
Display "malformed_out.tif" "file" "rgba"
Format 200 200 1
Projection "perspective" "fov" [45]
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [0.6]
Surface "matte" "Ka" [1] "Kd" [0]
AttributeBegin
	GeneralPolygon [4 1500000] "P" [
		-0.4 -0.4 0  0.4 -0.4 0  0.4 0.4 0  -0.4 0.4 0
	]
AttributeEnd
AttributeBegin
	Translate 2 0 0
	Sphere 0.5 -0.5 0.5 360
AttributeEnd
WorldEnd
