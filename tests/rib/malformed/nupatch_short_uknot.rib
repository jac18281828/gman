# uknot one value short: nu=2 uorder=2 declares nu+uorder=4 knots, but
# only three are supplied. The RI signature carries no knot-array length,
# so parseNuPatch checks it itself and calls nothing rather than handing
# RiNuPatchV a short array.
#
# A trailing Sphere follows AGENTS.md's "RIB authoring" section, "The
# desync convention."
Display "malformed_out.tif" "file" "rgba"
Format 200 200 1
Projection "perspective" "fov" [45]
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [0.6]
Surface "matte" "Ka" [1] "Kd" [0]
NuPatch 2 2 [0 0 1] 0 1 2 2 [0 0 1 1] 0 1
	"P" [-1 -1 0  1 -1 0  -1 1 0  1 1 0]
AttributeBegin
	Translate 2 0 0
	Sphere 0.5 -0.5 0.5 360
AttributeEnd
WorldEnd
