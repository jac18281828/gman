# Transform branch: 16 tokens, the last a string. gman is expected to stop
# with RIE_SYNTAX, the wrong token, not RIE_CONSISTENCY.
#
# A trailing Sphere follows AGENTS.md's "RIB authoring" section, "The
# desync convention."
Display "malformed_out.tif" "file" "rgba"
Format 200 200 1
Projection "perspective" "fov" [45]
Clipping 0.5 50
Translate 0 0 5
WorldBegin
Transform [ 0.125 0.25 0.375 0.5 0.625 0.75 0.875 1 1.125 1.25 1.375 1.5 1.625 1.75 1.875 "two" ]
Sphere 1 -1 1 360
WorldEnd
