## An OpenEXR Display with Quantize "rgba" 0 0 0 and a dither amplitude
## writes the same float samples: only a nonzero one is refused. The covered
## half plane shades at exactly 3.0.
Display "exrdither.exr" "file" "rgba"
Format 16 16 1
Projection "orthographic"
Clipping 0.5 50
PixelFilter "box" 1 1
PixelSamples 1 1
Quantize "rgba" 0 0 0 0.25
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [4]
Color [0.75 0.75 0.75]
Surface "matte" "Ka" [1] "Kd" [0]
Polygon "P" [ -10 -10 0  -0.03 -10 0  -0.03 10 0  -10 10 0 ]
WorldEnd
