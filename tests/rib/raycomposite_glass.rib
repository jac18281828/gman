## A black Opacity 0.5 panel before a lit wall, seen directly on the right of the frame and through a clear glass
## slab on the left: the ray tracer composites the panel through the slab as the path tracer does. Not third-party.
Display "raycomposite_glass.tif" "file" "rgba"
Format 64 48 1
PixelSamples 2 2
Option "pathtracer" "integer samples" [64]
Projection "perspective" "fov" [40]
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "distantlight" 1 "from" [-6 0 -2] "to" [0 0 0] "intensity" [3]
Surface "matte" "Kd" [0.8]
Polygon "P" [-8 -6 4  -8 6 4  8 6 4  8 -6 4]
AttributeBegin
Opacity [0.5 0.5 0.5]
Surface "matte" "Kd" [0]
Polygon "P" [-3.3 -2.6 1  -3.3 2.6 1  3.3 2.6 1  3.3 -2.6 1]
AttributeEnd
AttributeBegin
Surface "glass"
Polygon "P" [-4 -3 -2  -4 3 -2  0 3 -2  0 -3 -2]
Polygon "P" [-4 -3 -1.9  0 -3 -1.9  0 3 -1.9  -4 3 -1.9]
AttributeEnd
WorldEnd
