## The same scene as declaredfov.rib, fov 90 in place of 30: the render
## tests/declaredfov_test.cpp compares against to prove a redeclared
## "fov" actually changes the image, not just the printed warning.
Display "declaredfov90.tif" "file" "rgba"
Format 100 100 1
Declare "fov" "float"
Projection "perspective" "fov" [90]
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "ambientlight" 1 "intensity" [1.0]
Sides 2
Color [1 1 1]
Surface "matte" "Ka" [1.0] "Kd" [0.0]
Polygon "P" [-1 -1 0  1 -1 0  1 1 0  -1 1 0]
WorldEnd
