## A paintedplastic card facing the camera, its "normalname" map tilting the
## shading normal along dPdu, under one distant light tilted the same way
## (tests/normalmappathtracer_test.cpp). The card is the only geometry in view,
## so the path tracer's estimate there is its next-event term. Not third-party.
Display "normalmap_card.tif" "file" "rgba"
Format 48 48 1
Projection "perspective" "fov" [45]
Clipping 0.5 50
Translate 0 0 5
WorldBegin
LightSource "distantlight" 1 "intensity" [1] "from" [0 0 0] "to" [-1 0 1]
Surface "paintedplastic" "Ka" [0] "Kd" [1] "Ks" [0]
	"string normalname" ["normalmap_pt_tilt.tif"]
Polygon "P" [-1 -1 0  -1 1 0  1 1 0  1 -1 0]
	"st" [0 0  0 1  1 1  1 0]
TransformBegin
	Translate 100 100 0
	Sphere 1 -1 1 360
TransformEnd
WorldEnd
